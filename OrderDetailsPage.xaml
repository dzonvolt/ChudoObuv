<Page x:Class="ChudoObuv.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChudoObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderDetailsPage"
      Unloaded="Page_Unloaded">

    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Информация о заказе" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23"/>


        <StackPanel Grid.Row="1" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Клиент: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Order.users.FullName}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Дата заказа: " FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding Order.date}" IsEnabled="{Binding EditEnabled}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Сумма заказа: " FontWeight="Bold"/>
                <TextBlock Name="ToTa" Text="{Binding Order.TotalPrice, StringFormat='{}{0} руб.'}"/>
            </StackPanel>
        </StackPanel>

        <Button Name="AddPositionBTN" Content="Добавить товарную позицию" Grid.Row="2" Click="AddPositionBTN_Click" Visibility="{Binding EditEnabled}"/>
        
        <ListView Grid.Row="3" Name="ItemsListView" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Order.order_items}">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Name="RemoveFromOrderBTN" Header="Удалить из заказа" Click="RemoveFromOrderBTN_Click" IsEnabled="{Binding EditEnabled}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1">
                        <Grid Height="auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding positions.products.ImagePath}" Grid.Column="0" Width="100"/>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="{Binding positions.products.CategoryName, StringFormat='Категория: {0}'}"/>
                                <TextBlock Text="{Binding count, StringFormat='Количество: {0}'}"/>
                                <TextBlock Text="{Binding positions.products.construction, StringFormat='Состсав: {0}'}"/>
                                <TextBlock Text="{Binding positions.size, StringFormat='Размер: {0}'}"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Column="2" IsEnabled="{Binding EditEnabled, RelativeSource={RelativeSource AncestorType=Page}}">
                                <TextBlock Text="{Binding positions.products.ManufacturerAndName}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                                    <TextBlock Text="Количество: "/>
                                    <Button Name="MinusItemsBTN" Content="-" Click="MinusItemsBTN_Click" Padding="3,0,3,0"/>
                                    <TextBlock Text="{Binding count}" Margin="3,0,3,0" VerticalAlignment="Center"/>
                                    <Button Name="PlusItemsBTN" Content="+" Click="PlusItemsBTN_Click" Padding="3,0,3,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Размер: "/>
                                    <ComboBox Name="SelectSizeCB" ItemsSource="{Binding positions.products.positions}" DisplayMemberPath="size" SelectedItem="{Binding positions, Mode=OneWay}" SelectionChanged="SelectSizeCB_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding positions.products.DiscountedPrice, StringFormat='{}{0} руб.'}" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <UniformGrid Rows="1" Columns="2" Grid.Row="4">
            <Button Name="DleteBTN" Content="Удалить заказ" DockPanel.Dock="Left" Background="Coral" Click="DleteBTN_Click" Padding="5"/>
            <Button Name="SaveBTN" Content="Сохранить заказ" DockPanel.Dock="Right" Click="SaveBTN_Click" Padding="5" IsEnabled="{Binding EditEnabled}"/>
        </UniformGrid>

    </Grid>
</Page>
