<Window x:Class="ChudoObuv.SelectProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChudoObuv"
        mc:Ignorable="d"
        Title="Выбор продукта" Height="450" Width="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Каталог товаров" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="23"/>
            <Button Name="CancelBTN" Content="Отменить выбор" HorizontalAlignment="Right" Margin="5" Click="CancelBTN_Click"/>

            <ListView Grid.Row="1" Name="ProductsListView" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Products}" SelectionChanged="ProductsListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Background="{Binding BackgroundColor}">
                            <Grid Height="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImagePath}" Grid.Column="0" Width="100"/>

                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="{Binding CategoryName, StringFormat='Категория: {0}'}"/>
                                    <TextBlock Text="{Binding CountString, StringFormat='Количество: {0}'}"/>
                                    <TextBlock Text="{Binding construction, StringFormat='Состсав: {0}'}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ManufacturerAndName}" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding DiscountedPrice, StringFormat='{}{0} руб.'}" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
