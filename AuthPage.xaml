<Page x:Class="ChudoObuv.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChudoObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontSize="15"
      Background="{StaticResource MainBackgroundColor}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Авторизация" FontSize="30" Margin="0,0,0,100" HorizontalAlignment="Center"/>
            
            <TextBlock Text="Имя пользователя:" Margin="0,0,0,5"/>
            <TextBox Name="LoginTB"/>
            <Button Content="Войти" Width="220" Margin="0,20,0,0" Click="AuthButton_Click"/>
            <Button Content="Продолжить без авторизации" Width="220" Margin="0,20,0,0" Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
