<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChudoObuv"
        mc:Ignorable="d"
        Title="Чудо Обувь" MinHeight="600" MinWidth="1300"
        Icon="/res/Чудо Обувь.ico"
        FontFamily="Calibri"
        FontSize="15">
    <Grid Background="{StaticResource SecondaryBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <Button Name="BackButton" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="5" Margin="10,0,0,0" Visibility="Hidden" Click="BackButton_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/res/Чудо Обувь.png" Margin="10"/>
                <TextBlock Text="Чудо Обувь" FontSize="30" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Column="2" Name="CurrentUserInfoTB" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/>

        </Grid>

        
        <Frame Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
